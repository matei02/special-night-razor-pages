@page
@model Website.Pages.LoginModel
@{
    ViewData["Title"] = "Login page";
}

<div class="d-flex h-100 justify-content-center align-items-center p-3">
    <div class="flex-row h-100 w-100 mt-0">
        <div class="page-title-container">
            <h1 class="display-4">Authenticate</h1>
        </div>
        <div class="row">
        <div class="text-center container-fluid h-100 d-inline-block">
            <label class="alert-danger align-self-end"><strong>@Model.Message</strong></label>
            <form method="post" class="h-100 mt-5" novalidate>
                <div class="container-fluid h-100">

                    <div class="row h-100">
                            <div class="col-12 col-sm-12 col-md-6 col-lg-6 border-end border-4 border-dark h-100 auth_form">
                            <h3>Register</h3>
                            <div class="col-lg-12 mt-5">
                                <div class="form-floating">
                                    <input asp-for="Name" type="text" class="form-control" id="floatingInput" placeholder="FirstName LastName">
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                    <label for="floatingInput">Full Name</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control" id="floatingInput" placeholder="name@example.com">
                                    <span class="text-danger" asp-validation-for="Email"></span>
                                    <label for="floatingInput">Email address</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password">
                                    <span class="text-danger" asp-validation-for="Password"></span>
                                    <label for="floatingPassword">Password</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="floatingPassword" placeholder="Repeat password">
                                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                    <label for="floatingPassword">Confirm password</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="Address" type="text" class="form-control" id="floatingInput" placeholder="Address">
                                    <span class="text-danger" asp-validation-for="Address"></span>
                                    <label for="floatingInput">Address</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="PhoneNumber" type="number" class="form-control" id="floatingInput" placeholder="Phone Number">
                                    <span class="text-danger" asp-validation-for="PhoneNumber"></span>
                                    <label for="floatingInput">Phone number</label>
                                </div>
                            </div>

                            <br />
                                <div class="col-lg-12">
                                    <div class="form-floating">
                                        <input asp-for="Age" type="number" class="form-control" id="floatingInput" placeholder="Age">
                                        <span class="text-danger" asp-validation-for="Age"></span>
                                        <label for="floatingInput">Age</label>
                                    </div>
                                </div>
                            <br />
                                <div class="col-lg-12">
                                    <div class="form-floating">
                                        <select asp-for="Gender" class="form-select" id="genderSelect">
                                            <option value="male">Male</option>
                                            <option value="female">Female</option>
                                        </select>
                                        <span class="text-danger" asp-validation-for="Gender"></span>
                                        <label for="genderSelect">Gender</label>
                                    </div>
                                </div>
                            <br />

                            <button asp-page-handler="SignUp" class="btn btn-outline-primary mb-5" onclick="ValidateEmail()">Sign up</button>

                            @*<script type="text/javascript">
                                function ValidateEmail() {
                                    var email = document.getElementById("txtEmail").value;
                                    var lblError = document.getElementById("lblError");
                                    lblError.innerHTML = "";
                                    var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
                                    if (!expr.test(email)) {
                                        lblError.innerHTML = "Invalid email address.";
                                    }
                                }
                            </script>*@



                        </div>

                            <div class="col-12 col-sm-12 col-md-6 col-lg-6 h-100 auth_form">
                            <h3>Log in</h3>
                            <div class="col-lg-12 mt-5">
                                <div class="form-floating">
                                    <input asp-for="LogEmail" type="email" class="form-control" id="floatingInput" placeholder="name@example.com">
                                    <span class="text-danger" asp-validation-for="LogEmail"></span>
                                    <label for="floatingInput">Email address</label>
                                </div>
                            </div>
                            <br />
                            <div class="col-lg-12">
                                <div class="form-floating">
                                    <input asp-for="LogPassword" type="password" class="form-control" id="floatingPassword" placeholder="Password">
                                    <span class="text-danger" asp-validation-for="LogPassword"></span>
                                    <label for="floatingPassword">Password</label>
                                </div>
                            </div>
                            <br />

                            <button asp-page-handler="Login" class="btn btn-outline-primary" onclick="ValidateEmail()">Log in</button>

                            @*<script type="text/javascript">
                                function ValidateEmail() {
                                    var email = document.getElementById("txtEmail").value;
                                    var lblError = document.getElementById("lblError");
                                    lblError.innerHTML = "";
                                    var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
                                    if (!expr.test(email)) {
                                        lblError.innerHTML = "Invalid email address.";
                                    }
                                }
                            </script>*@

                            <br />
                        </div>
                    </div>
                </div>
            </form>
        </div>

    </div>
</div>
</div>

<partial name="_ValidationScriptsPartial" />