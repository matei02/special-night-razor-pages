@page
@using DomainsLayer;
@using DomainsLayer.Classes;
@model Website.Pages.Shopping_CartModel
@{
	ViewData["Title"] = "Shopping cart";
}
<div class="p-3">
    <div class="page-title-container">
        <h1 class="display-4">Shopping Cart</h1>
        <p class="lead"></p>
    </div>

@*
    <div class="d-flex">
        <label class="alert-danger align-self-center"><strong>@Model.Message</strong></label>
    </div>*@
    @if (HttpContext.Session.GetString("Name") != null)
    {
        <section class="h-100 ">
            <div class="container py-5">
                <div class="row d-flex justify-content-center my-4 w-100">
                    <label class="alert-danger align-self-center"><strong>@Model.Message</strong></label>
                    <div class="col-md-12">
                        <div class="card mb-4">
                            <div class="card-header py-3">
                                <h5 class="mb-0">@Model.ShoppingCartManager.GetAllShoppingCartProducts(HttpContext.Session.GetInt32("id")).Count Products in cart</h5>
                            </div>
                            <div class="card-body">
                                <!-- Single item -->
                                @foreach (Product p in Model.ShoppingCartManager.GetAllShoppingCartProducts(HttpContext.Session.GetInt32("id")))
                                {
                                    if (p is Dress)
                                    {
                                        Dress dress = (Dress)p;
                                        <div class="row mb-4">
                                            <div class="col-lg-3 col-md-12 mb-4 mb-lg-0">
                                                <!-- Image -->
                                                <div class="bg-image hover-overlay hover-zoom ripple rounded" data-mdb-ripple-color="light">
                                                    @if (dress.GetColor() == DressColors.RED)
                                                    {
                                                        <img src="~/Pictures/red dress.jpg" class="card-img w-100 cart-pictures" style="height: 300px !important;" alt="Red Dress">
                                                    }
                                                    else if (dress.GetColor() == DressColors.BLUE)
                                                    {
                                                        <img src="~/Pictures/blue dress.jpg" class="card-img w-100 cart-pictures" style="height: 300px !important;" alt="Red Dress">
                                                    }
                                                    else
                                                    {
                                                        <img src="~/Pictures/black dress.jpg" class="card-img w-100 cart-pictures" style="height: 300px !important;" alt="Red Dress">
                                                    }
                                                </div>
                                                <!-- Image -->
                                            </div>

                                            <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">
                                                <!-- Data -->
                                                <p><strong>@dress.GetName()</strong></p>
                                                <p>Color: @dress.GetColor().ToString()</p>
                                                <p>Size Bust: @dress.GetSizeB()</p>
                                                <p>Size Waist: @dress.GetSizeW()</p>
                                                <p>Size Hips: @dress.GetSizeH()</p>
                                                <form method="post">
                                                    <input asp-for="ProductID" type="hidden" value="@dress.GetID()">
                                                    <button asp-page-handler="RemoveFromCart" asp-route-productID="@dress.GetID()" type="submit" class="btn-danger px-3 me-2 mx-lg-1 btn" style="height:38px;">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                                <!-- Data -->
                                            </div>

                                            <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                                                <!-- Quantity -->
                                                <div class="d-flex mb-4" style="max-width: 300px">
                                                    <form method="post">
                                                        <input asp-for="ProductID" type="hidden" value="@dress.GetID()">
                                                        <button asp-page-handler="DecreaseQuantity" class="btn-primary px-3 me-2 mx-lg-1 btn" style="height:38px;"
                                                                disabled="@(dress.Quantity <= 1 ? "disabled" : null)">
                                                            <i class="fas fa-minus"></i>
                                                        </button>
                                                    </form>

                                                    <div class="form-outline">
                                                        <input id="form1" min="1" name="quantity" value="@dress.Quantity" type="number" readonly class="form-control"
                                                               oninput="if (this.value < 1) this.value = 1;" />
                                                        <label class="form-label" for="form1">Quantity</label>
                                                    </div>

                                                    <form method="post">
                                                        <input asp-for="ProductID" type="hidden" value="@dress.GetID()">
                                                        <button asp-page-handler="IncreaseQuantity" class="btn-primary px-3 me-2 mx-lg-1 btn" style="height:38px;"
                                                                disabled="@(dress.Quantity == Model.productManager.GetDressesStock().Count ? "disabled" : null)">
                                                            <i class="fas fa-plus"></i>
                                                        </button>
                                                    </form>
                                                </div>



                                                <!-- Quantity -->
                                                <!-- Price -->
                                                <p class="text-start text-md-center">
                                                    <strong>€@dress.GetPrice() per piece.</strong>
                                                </p>
                                                <!-- Price -->
                                            </div>
                                        </div>
                                    }
