                                                }
                                            }
                                        }
                                    </div>
                                </div>
                                
                                
                                @if (recommendedProducts.Count < 1)
                                {
                                    <div class="card-body">
                                        <p>No recommended products available.</p>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-12 mt-5">
                            <div class="card mb-4">
                                <div class="card-header py-3">
                                    <h5 class="mb-0">Summary</h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                            Products
                                            <span>€@Model.ShoppingCartManager.GetTotal(HttpContext.Session.GetInt32("id"))</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            Shipping
                                            <span>Free</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-3">
                                            <div>
                                                <strong>Total amount</strong>
                                                <strong>
                                                    <p class="mb-0">(including VAT)</p>
                                                </strong>
                                            </div>
                                            <span><strong>€@Model.ShoppingCartManager.GetTotal(HttpContext.Session.GetInt32("id"))</strong></span>
                                        </li>
                                    </ul>
                                    @if ((HttpContext.Session.GetString("Name") != null) && Model.ShoppingCartManager.GetAllShoppingCartProducts(HttpContext.Session.GetInt32("id")).Count >= 1)
                                    {
                                        <form method="post">
                                            <button asp-page-handler="PlaceOrder" type="submit" class="btn btn-primary btn-lg btn-block">
                                                Place order
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <p><strong>Your shopping cart is empty!</strong></p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="text-center">
            <form method="post">
                <h1>Authenticate first before using the shopping cart!</h1>
                
                <button asp-page-handler="GoToLogin" class="btn-primary" type="submit">Login</button>
            </form>
        </div>
        
    }
</div>
