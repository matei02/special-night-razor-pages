@page
@using DataAccessLayer
@using DomainsLayer
@using LogicLayer
@model Website.Pages.SuitsModel
@{
	ViewData["Title"] = "Suits";
}

<div class="container-fluid px-4 p-3">

    <!-- Page title -->
    <div class="page-title-container">
        <h1 class="display-4">Suits</h1>
        <p class="lead">Browse through our wonderful collection of suits.</p>
    </div>
    <div class="row">
        @foreach (Product product in Model.GetAllSuits)
        {
            <div class="col-12 col-md-6">
                <a class="text-decoration-none text-dark" asp-page="Details" asp-route-id="@product.GetID()">
                    @if (product is Suit)
                    {
                        Suit suit = (Suit)product;
                        if (suit.Quantity >= 1)
                        {
                            <div class="card mb-3 p-4 card-custom">
                                <div class="row g-0 d-flex justify-content-center align-items-center">
                                    <div class="col-md-4 picture">
                                        @if (suit.GetColor() == SuitColors.BLACK)
                                        {
                                            <img src="~/Pictures/black suit.jpg" class="card-img" alt="Black Suit">
                                        }
                                        else if (suit.GetColor() == SuitColors.NAVY)
                                        {
                                            <img src="~/Pictures/navy suit.jpeg" class="card-img" alt="Navy Suit">
                                        }
                                        else
                                        {
                                            <img src="~/Pictures/brown suit.jpg" class="card-img" alt="Brown Suit">
                                        }
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body card-body-custom">
                                            <h2 class="text-capitalize">@suit.GetName()</h2>
                                            <div claclass="card-info">
                                                <p class="card-text">Description: @suit</p>
                                                <p class="card-text">Available quantity: @suit.Quantity</p>
                                                <p class="card-text"><small class="text-muted">Lorem ipsum sin dolor</small></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </a>
            </div>
        }
    </div>
</div>