@page
@using DataAccessLayer
@using DomainsLayer
@using LogicLayer
@model Website.Pages.DetailsModel
@{
}
<div class="text-center">
	<div class="row">
		@if (Model.dress != null)
		{
			<div class="container-fluid align-self-center">
				<div class="row g-0 d-flex justify-content-center align-items-center">
					<div class="col-6 col-sm-4">
						@if (Model.dress.GetColor() == DressColors.RED)
						{
							<img src="~/Pictures/red dress.jpg" class="detailpage-img" alt="Red Dress">
						}
						else if (Model.dress.GetColor() == DressColors.BLUE)
						{
							<img src="~/Pictures/blue dress.jpg" class="detailpage-img" alt="Blue Dress">
						}
						else
						{
							<img src="~/Pictures/black dress.jpg" class="detailpage-img" alt="Black Dress">
						}
					</div>
					<div class="col-6 col-sm-8 p-3">
						<div class="card-body card-body-custom">
							<h2 class="text-capitalize">@Model.dress.GetName()</h2>
							<div claclass="card-info">
								<p class="card-text">Size Bust: @Model.dress.GetSizeB()'</p>
								<p class="card-text">Size Waist: @Model.dress.GetSizeW()'</p>
								<p class="card-text">Size Hips: @Model.dress.GetSizeH()'</p>
								<p class="card-text">Price: €@Model.dress.GetPrice()</p>
								<p class="card-text">Available quantity: @Model.dress.Quantity</p>
								@if (HttpContext.Session.GetString("Name") != null)
								{
									if (!Model.DoesCustomerHaveRental)
									{
										if (Model.EqualCartAndStock(Model.dress.GetID()))
										{
											<p><strong>There are no more pieces in stock.</strong></p>
										}
										else
										{
											<form method="post">
												<button asp-page-handler="AddToCart" class="btn-dark">Add to cart</button>
												<input asp-for="ProductID" type="hidden" value="@Model.dress.GetID()" />
											</form>
											<p>@Model.Message</p>
										}
									}
									else
									{
										<p><strong>You currently have a rental in progress.</strong></p>
									}
								}
								else
								{
									<form method="post">
										<p><strong>Authenticate first to be able to add to cart.</strong></p>
										<button asp-page-handler="GoToLogin" class="btn-primary" type="submit">Login</button>
									</form>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		}
